{
  "name": "wp_restatify-base-theme",
  "version": "1.2.2",
  "description": "Custom WordPress Theme with Gutenberg Block Library",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "package": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-release-zip.ps1",
    "test:dependencies": "node --test scripts/test-build-dependencies.cjs",
    "test:unit:js": "wp-scripts test-unit-jest",
    "test:unit:js:watch": "wp-scripts test-unit-jest --watch"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "markdownlint-cli": {
      "js-yaml": "^5.4.1",
      "smol-toml": "^1.9.0"
    },
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.1",
    "launch-editor": "^2.14.2",
    "markdown-it": "^14.3.3",
    "qs": "^6.16.1",
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "cssnano": {
      "postcss-selector-parser": "^7.1.6"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "serialize-javascript": "^7.1.3"
  },
  "author": "",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@wordpress/babel-preset-default": "8.55.0",
    "@wordpress/jest-preset-default": "14.2.0",
    "@wordpress/scripts": "^36.1.0",
    "babel-jest": "30.5.0",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0"
  }
}
